export type BusinessAudit = {
  score: number;
  status: string;
  completedFields: number;
  totalFields: number;
  strengths: string[];
  weaknesses: string[];
  suggestions: string[];
  tasks: string[];
};

type BusinessData = {
  businessName: string;
  category: string;
  location: string;
  phone: string;
  website: string;
};

export function runGrowthAudit(
  business: BusinessData
): BusinessAudit {
  const strengths: string[] = [];
  const weaknesses: string[] = [];
  const suggestions: string[] = [];
  const tasks: string[] = [];

  /*
   * REAL GROWTH SCORE
   *
   * 1. Business Profile      20
   * 2. Local Visibility      25
   * 3. Customer Reviews      15
   * 4. Customer Acquisition   15
   * 5. Customer Retention     15
   * 6. Weekly Activity        10
   *
   * Current BusinessData only contains profile information.
   * Therefore unavailable growth signals are intentionally not
   * given points. This prevents a complete profile from becoming 100/100.
   */

  let score = 0;

  // --------------------------------------------------
  // 1. BUSINESS PROFILE — 20 POINTS
  // --------------------------------------------------

  const profileFields = [
    business.businessName,
    business.category,
    business.location,
    business.phone,
    business.website,
  ];

  const completedFields = profileFields.filter(
    (field) => field?.trim()
  ).length;

  const totalFields = profileFields.length;

  const profileScore = Math.round(
    (completedFields / totalFields) * 20
  );

  score += profileScore;

  if (business.businessName?.trim()) {
    strengths.push("Business name is available.");
  } else {
    weaknesses.push("Business name is missing.");
    tasks.push("Complete your business name.");
  }

  if (business.category?.trim()) {
    strengths.push("Business category is defined.");
  } else {
    weaknesses.push("Business category is missing.");
    tasks.push("Add your business category.");
  }

  if (business.location?.trim()) {
    strengths.push("Business location is available.");
  } else {
    weaknesses.push("Business location is missing.");
    tasks.push("Add your business location.");
  }

  if (business.phone?.trim()) {
    strengths.push("Business phone number is available.");
  } else {
    weaknesses.push("Business phone number is missing.");
    tasks.push("Add a business phone number.");
  }

  if (business.website?.trim()) {
    strengths.push("Business website is available.");
  } else {
    weaknesses.push("Business website is missing.");
    suggestions.push(
      "Add a professional website to strengthen your online presence."
    );
    tasks.push("Add a business website.");
  }

  // --------------------------------------------------
  // 2. LOCAL VISIBILITY — 25 POINTS
  // --------------------------------------------------

  /*
   * We currently cannot verify the actual Google Business Profile.
   * A complete profile therefore does NOT receive these points.
   */

  weaknesses.push(
    "Google Business Profile activity has not been verified."
  );

  suggestions.push(
    "Create and optimize your Google Business Profile."
  );

  tasks.push(
    "Create or optimize Google Business Profile."
  );

  // --------------------------------------------------
  // 3. CUSTOMER REVIEWS — 15 POINTS
  // --------------------------------------------------

  weaknesses.push(
    "Customer review growth has not been established."
  );

  suggestions.push(
    "Collect genuine customer reviews to build local trust."
  );

  tasks.push(
    "Collect 5 genuine customer reviews."
  );

  // --------------------------------------------------
  // 4. CUSTOMER ACQUISITION — 15 POINTS
  // --------------------------------------------------

  weaknesses.push(
    "A repeatable customer acquisition activity has not been established."
  );

  suggestions.push(
    "Create a simple weekly offer to attract customers."
  );

  tasks.push(
    "Create a consistent weekly customer offer."
  );

  // --------------------------------------------------
  // 5. CUSTOMER RETENTION — 15 POINTS
  // --------------------------------------------------

  weaknesses.push(
    "Customer retention activity has not been established."
  );

  suggestions.push(
    "Follow up with existing customers and give them a reason to return."
  );

  tasks.push(
    "Create a customer follow-up and return offer."
  );

  // --------------------------------------------------
  // 6. WEEKLY ACTIVITY — 10 POINTS
  // --------------------------------------------------

  weaknesses.push(
    "Weekly growth activity has not yet been established."
  );

  suggestions.push(
    "Maintain a simple weekly growth activity."
  );

  tasks.push(
    "Complete one growth action every week."
  );

  // --------------------------------------------------
  // STATUS
  // --------------------------------------------------

  let status = "Needs Improvement";

  if (score >= 80) {
    status = "Excellent";
  } else if (score >= 60) {
    status = "Good";
  } else if (score >= 40) {
    status = "Fair";
  }

  // --------------------------------------------------
  // REMOVE DUPLICATES
  // --------------------------------------------------

  const uniqueTasks = [...new Set(tasks)];
  const uniqueSuggestions = [...new Set(suggestions)];

  return {
    score: Math.min(100, score),
    status,
    completedFields,
    totalFields,
    strengths,
    weaknesses,
    suggestions: uniqueSuggestions.slice(0, 5),
    tasks: uniqueTasks.slice(0, 5),
  };
}
