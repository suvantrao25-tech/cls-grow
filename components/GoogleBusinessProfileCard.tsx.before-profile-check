"use client";

import { useBusiness } from "./BusinessContext";

export default function GoogleBusinessProfileCard() {
  const { business } = useBusiness();

  const searchText = [business.businessName, business.location]
    .filter(Boolean)
    .join(", ");

  const googleSearchUrl = searchText
    ? `https://www.google.com/search?q=${encodeURIComponent(searchText)}`
    : "https://www.google.com/business/";

  return (
    <div className="bg-white border border-blue-100 rounded-2xl p-6 shadow-sm">
      <p className="text-sm font-semibold text-blue-600 uppercase tracking-wide">
        Local Visibility
      </p>

      <h2 className="text-xl font-bold text-gray-900 mt-2">
        Google Business Profile
      </h2>

      <p className="text-gray-600 mt-2">
        Help customers find your business on Google. Check your listing,
        improve your information, and keep your profile active.
      </p>

      <div className="mt-5 space-y-3">
        <div className="flex items-center justify-between border rounded-lg p-3">
          <span className="font-medium text-gray-700">
            Business information
          </span>
          <span className="text-sm text-green-600 font-semibold">
            {business.businessName && business.location ? "Ready to check" : "Complete profile first"}
          </span>
        </div>

        <div className="flex items-center justify-between border rounded-lg p-3">
          <span className="font-medium text-gray-700">
            Google listing
          </span>
          <span className="text-sm text-gray-500">
            Check your profile
          </span>
        </div>
      </div>

      <a
        href={googleSearchUrl}
        target="_blank"
        rel="noopener noreferrer"
        className="mt-5 inline-flex items-center justify-center px-5 py-3 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700"
      >
        Check on Google
      </a>

      <p className="text-xs text-gray-500 mt-3">
        You remain in control of your Google Business Profile. CLS GROW does
        not make changes without your approval.
      </p>
    </div>
  );
}
